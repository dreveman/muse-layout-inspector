{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rootDir": "..",
    "tsBuildInfoFile": "./.tsbuildinfo.client",
    "paths": {
      "@space/server/*": ["../server/src/*"]
    }
  },
  "include": ["src/**/*", "../server/src/**/*"]
}
